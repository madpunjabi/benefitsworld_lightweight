# Copy to .env (gitignored). Shared secret gating the /lab router.
# Not production auth — the simplest reliable isolation for a local benchmark.
LAB_TOKEN=dev-lab-token-change-me
SCENARIO_ID=BW-001
SCENARIO_VERSION=0.1
AGENT_ORIGIN=http://localhost:5173
LAB_ORIGIN=http://localhost:5174

# --- Deployment-only (all optional locally; see below for defaults) --------

# "development" (default) or "production". Governs RESET_ON_BOOT's default
# and the Lab Console session cookie's Secure/SameSite attributes. Set to
# "production" only on the hosted (Railway) deployment.
ENVIRONMENT=development

# Whether the backend resets to Day 0 on every process start. Defaults to
# true in development (original behavior, unchanged) and false in
# production (a hosted process restart must not silently wipe a live
# demo). Uncomment to override the default explicitly either way.
# RESET_ON_BOOT=true

# Where the SQLite file lives. Point this at a persistent volume's mount
# path in production (e.g. /data/benefitsworld.db on Railway).
DATABASE_PATH=backend/benefitsworld.db

# Demo-only Lab Console login (see backend/app/security.py). Never sent
# to, or embedded in, any frontend bundle — the browser only ever submits
# LAB_CONSOLE_PASSWORD once, to POST /lab/login, which then sets an
# HttpOnly session cookie signed with SESSION_SECRET.
SESSION_SECRET=dev-session-secret-change-me
LAB_CONSOLE_PASSWORD=dev-lab-password-change-me
